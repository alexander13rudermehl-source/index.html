{
  "rules": {
    ".read": true,
    ".write": true,
    "users": {
      "$uid": {
        "role": {
          ".validate": "(!data.exists() && newData.val() === 'user') || (data.exists() && newData.val() === data.val())"
        }
      }
    },
    "battles": {
      "$code": {
        ".validate": "newData.hasChildren(['hostId'])"
      }
    }
  }
}
